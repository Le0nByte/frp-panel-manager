# fixture env (offline test only) -- contains secret-like values that must never
# appear in manifests, script output, or evidence.
APP_GLOBAL_SECRET=ENVSECRET_FIXTURE_0123456789
APP_COOKIE_SECURE=true
APP_ENABLE_REGISTER=false
MASTER_API_HOST=127.0.0.1
MASTER_API_PORT=9100
MASTER_RPC_PORT=9101
MASTER_SNAPSHOT_KEY_FILE=/opt/frp-panel/secrets/snapshot.key
CLIENT_SECRET=CLIENTSECRET_FIXTURE_0123456789
DB_TYPE=sqlite3
DB_DSN=/opt/frp-panel/data/data.db?_pragma=journal_mode(WAL)
