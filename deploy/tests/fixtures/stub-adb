#!/usr/bin/env bash
# Test stub for adb. Records invocations to $STUB_LOG.
#   adb devices        -> prints STUB_ADB_DEVICES (default lists one device)
#   adb shell <cmd...> -> prints STUB_ADB_SHELL_OUTPUT, exit STUB_ADB_SHELL_EXIT
set -u
printf 'adb %s\n' "$*" >> "${STUB_LOG:?STUB_LOG must be set}"
case "${1:-}" in
  devices)
    printf '%s\n' "${STUB_ADB_DEVICES:-List of devices attached
K30DEVICE	device}"
    exit 0
    ;;
  shell)
    printf '%s\n' "${STUB_ADB_SHELL_OUTPUT:-}"
    exit "${STUB_ADB_SHELL_EXIT:-0}"
    ;;
  *) exit 0 ;;
esac
