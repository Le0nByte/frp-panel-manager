# Copy to /etc/frp-panel/frp-panel.env, set owner root:frp-panel and mode 0600.
# Temporarily set APP_ENABLE_REGISTER=true only for initial administrator creation.
APP_GLOBAL_SECRET=[REDACTED]
APP_COOKIE_SECURE=true
APP_COOKIE_HTTP_ONLY=true
APP_ENABLE_REGISTER=false
APP_COOKIE_AGE=86400
# Set this to the public IP or DNS name used by the Agent TLS certificate SAN.
# The management API listener remains loopback-bound by the deployment service.
MASTER_API_HOST=PUBLIC_IP_OR_DNS
MASTER_API_PORT=9100
MASTER_API_SCHEME=http
MASTER_RPC_HOST=0.0.0.0
MASTER_RPC_PORT=9101
MASTER_SNAPSHOT_KEY_FILE=/opt/frp-panel/secrets/snapshot.key
MASTER_FEATURES_ENABLE_PTY=false
MASTER_FEATURES_ENABLE_WORKER=false
MASTER_FEATURES_ENABLE_WIREGUARD=false
CLIENT_API_URL=https://PUBLIC_IP_OR_DNS:9443
CLIENT_RPC_URL=grpc://PUBLIC_IP_OR_DNS:9101
CLIENT_TLS_INSECURE_SKIP_VERIFY=false
CLIENT_FEATURES_ENABLE_FUNCTIONS=false
CLIENT_FEATURES_ENABLE_REMOTE_SHELL=false
CLIENT_FEATURES_ENABLE_WIREGUARD=false
CLIENT_ID=[REDACTED]
CLIENT_SECRET=[REDACTED]
DB_TYPE=sqlite3
DB_DSN=/opt/frp-panel/data/data.db?_pragma=journal_mode(WAL)
LOGGER_DEFAULT_LOGGER_LEVEL=info
LOGGER_FRP_LOGGER_LEVEL=info
